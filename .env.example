# ============================================================
# AI Customer Support Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   nano .env  # Fill in your values
#   docker compose -f docker-compose.staging.yml up --build

# ─── Database ───────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_customer_support_chatbot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ─── Security ───────────────────────────────────────────────
SECURITY_USER=admin
SECURITY_PASSWORD=admin123
JWT_SECRET_KEY=your-256-bit-jwt-secret-key-here

# ─── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Gemini API (Google AI Studio — free tier) ─────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Mail / SMTP (optional — for ticket email notifications) ─
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@codafriqa.local

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080

# ─── Docker Compose ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_customer_support_chatbot

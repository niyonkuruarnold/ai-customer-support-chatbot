# ============================================================
# AI Customer Support Chatbot — environment variable template
# Copy to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets.
# ============================================================

# --- Google Gemini (Spring AI) -------------------------------
# Required for real AI chat responses and knowledge base embeddings.
# Without it the app runs in degraded mode (fallback responses / 400s).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Email (ticket notifications via Mailtrap / SMTP) --------
# Set these to enable automated ticket emails. Mailtrap defaults:
#   host smtp.mailtrap.io, port 2525 (or 465/587 with TLS)
# Leave unset to keep the app bootable; send attempts then fail
# gracefully and are logged as warnings.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@codafriqa.local

# --- Database (defaults match docker-compose) ----------------
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# --- Spring Security agent credentials -----------------------
# SECURITY_USER=admin
# SECURITY_PASSWORD=admin123

# Copy this file to `.env` and fill in your real key, then start the backend:
#
#   cp .env.example .env      (Linux/macOS/Git Bash)
#   copy .env.example .env    (Windows cmd / PowerShell)
#
# The Spring Boot backend reads these values at startup (spring-dotenv loads
# the local .env file; real environment variables always take precedence).
# You can also skip the file and export the variable in your terminal instead:
#
#   export OPENAI_API_KEY=sk-...      (Linux/macOS/Git Bash)
#   $env:OPENAI_API_KEY = "sk-..."   (Windows PowerShell)
#
# ⚠️  SECURITY: `.env` is listed in .gitignore and must NEVER be committed.
# Only this `.env.example` template is tracked in git.

OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_OPENAI_API_KEY_HERE

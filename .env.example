# ============================================================
# AI Customer Support Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Database ───────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_customer_support_chatbot

# ─── Security ───────────────────────────────────────────────
SECURITY_USER=admin
SECURITY_PASSWORD=admin123

# ─── Gemini API (Google AI Studio — free tier) ─────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Mail / SMTP (optional — for ticket email notifications) ─
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@codafriqa.local

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080

# ─── Docker Compose ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_customer_support_chatbot

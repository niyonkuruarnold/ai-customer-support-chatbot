# Base URL of the Spring Boot backend REST API.
# The backend maps the chat controller at /api/chat (server.servlet.context-path=/).
# If your deployed backend serves the API under a different prefix (e.g. /api/v1),
# update this value to http://localhost:8080/api/v1 and restart the dev server.
VITE_API_BASE_URL=http://localhost:8080/api
